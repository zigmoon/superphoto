{
  "name": "superphoto",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "SuperPhoto — photo retouching studio in Astro + Rust (Tauri) for Windows, macOS and Linux.",
  "license": "MIT",
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "dev": "astro dev",
    "brand": "node scripts/brand.mjs",
    "brand:png": "node scripts/brand.mjs && node scripts/brand-png.mjs",
    "build": "astro build",
    "build:web": "node scripts/build-web.mjs",
    "build:web:zip": "node scripts/build-web.mjs --zip",
    "preview": "astro preview",
    "preview:web": "node scripts/serve-web.mjs",
    "check": "astro check",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:exe": "tauri build --debug --no-bundle",
    "desktop:build:debug": "tauri build --debug --no-bundle"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tauri-apps/cli": "^2.12.3",
    "astro": "^7.4.0",
    "typescript": "^6.0.3"
  }
}
