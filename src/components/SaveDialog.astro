---
import BrandMark from './BrandMark.astro';
---
<div class="modal-backdrop" id="save-modal" role="presentation">
  <div class="dialog save-dialog" role="dialog" aria-modal="true" aria-labelledby="save-title">
    <header class="dialog-head compact">
      <div class="dialog-kicker">
        <span class="kicker-mark"><BrandMark decorative /></span>
        SUPERPHOTO
      </div>
      <h2 id="save-title" data-i18n="save.title">Save a package</h2>
      <p data-i18n="save.subtitle">
        One .spp file: every layer, mask, text and colour mode. Reopen it with Open.
      </p>
      <button class="dialog-close" id="save-close" aria-label="Close" data-i18n-aria="common.close">
        <svg viewBox="0 0 24 24"><use href="#i-close"></use></svg>
      </button>
    </header>

    <div class="dialog-body">
      <div class="pane-label" data-i18n="save.scope">What to save</div>
      <div class="save-scope" id="save-scope">
        <button class="save-scope-card is-active" data-scope="current">
          <span class="save-scope-icon"><svg viewBox="0 0 24 24"><use href="#i-image-size"></use></svg></span>
          <strong data-i18n="save.currentTab">Current tab</strong>
          <small id="save-current-name">—</small>
        </button>
        <button class="save-scope-card" data-scope="all">
          <span class="save-scope-icon"><svg viewBox="0 0 24 24"><use href="#i-layers"></use></svg></span>
          <strong data-i18n="save.allTabs">All tabs</strong>
          <small id="save-all-count">—</small>
        </button>
      </div>

      <label class="field-label" for="save-filename">
        <span data-i18n="save.filename">File name</span>
        <input type="text" id="save-filename" class="text-input" value="superphoto.spp" spellcheck="false" />
      </label>

      <div class="save-summary" id="save-summary"></div>

      <p class="dialog-note" data-i18n="save.note">
        The package is a plain ZIP: rename it to .zip to inspect the JSON and the PNG layers.
      </p>
    </div>

    <footer class="dialog-foot">
      <div class="foot-spacer"></div>
      <button class="btn ghost" id="save-cancel" data-i18n="common.cancel">Cancel</button>
      <button class="btn primary" id="save-run">
        <svg viewBox="0 0 24 24"><use href="#i-save"></use></svg>
        <span data-i18n="save.run">Save</span>
      </button>
    </footer>
  </div>
</div>
