---
import BrandMark from './BrandMark.astro';
---
<header class="topbar">
  <div class="brand" aria-label="SuperPhoto">
    <span class="brand-mark" aria-hidden="true">
      <BrandMark decorative />
    </span>
  </div>

  <nav class="topbar-actions" aria-label="File" data-i18n-aria="topbar.file">
    <button class="tb-btn" id="btn-new" title="New document (Ctrl+N)" data-i18n-title="topbar.newTitle">
      <svg viewBox="0 0 24 24"><use href="#i-new"></use></svg>
      <span data-i18n="topbar.new">New</span>
    </button>
    <button class="tb-btn" id="btn-open" title="Open an image (Ctrl+O)" data-i18n-title="topbar.openTitle">
      <svg viewBox="0 0 24 24"><use href="#i-open"></use></svg>
      <span data-i18n="topbar.open">Open</span>
    </button>
    <span class="topbar-sep" aria-hidden="true"></span>
    <button class="tb-icon" id="btn-undo" title="Undo (Ctrl+Z)" aria-label="Undo" data-i18n-title="topbar.undoTitle" data-i18n-aria="topbar.undo" disabled>
      <svg viewBox="0 0 24 24"><use href="#i-undo"></use></svg>
    </button>
    <button class="tb-icon" id="btn-redo" title="Redo (Ctrl+Y)" aria-label="Redo" data-i18n-title="topbar.redoTitle" data-i18n-aria="topbar.redo" disabled>
      <svg viewBox="0 0 24 24"><use href="#i-redo"></use></svg>
    </button>
  </nav>

  <div class="doc-identity" aria-live="polite">
    <span class="doc-name" id="doc-name">No document</span>
    <span class="doc-meta" id="doc-meta">—</span>
  </div>

  <div class="topbar-tools">
    <div class="color-stack" title="Primary and secondary colors" data-i18n-title="topbar.colors">
      <button class="swatch swatch-primary" id="primary-swatch" aria-label="Primary color" data-i18n-aria="topbar.primary"></button>
      <button class="swatch swatch-secondary" id="secondary-swatch" aria-label="Secondary color" data-i18n-aria="topbar.secondary"></button>
      <button class="swatch-swap" id="swap-colors" title="Swap colors (X)" aria-label="Swap colors (X)" data-i18n-title="topbar.swap" data-i18n-aria="topbar.swap">
        <svg viewBox="0 0 24 24"><use href="#i-swap"></use></svg>
      </button>
      <input type="color" id="primary-color-input" class="native-color" value="#111114" tabindex="-1" />
      <input type="color" id="secondary-color-input" class="native-color" value="#ffffff" tabindex="-1" />
    </div>

    <span class="topbar-sep" aria-hidden="true"></span>
    <button class="tb-icon theme-toggle" id="btn-theme-toggle" title="Toggle light / dark" aria-label="Toggle light / dark" data-i18n-title="topbar.themeToggle" data-i18n-aria="topbar.themeToggle">
      <svg class="theme-icon-sun" viewBox="0 0 24 24"><use href="#i-sun"></use></svg>
      <svg class="theme-icon-moon" viewBox="0 0 24 24"><use href="#i-moon"></use></svg>
    </button>
    <button class="tb-icon panel-toggle" id="btn-toggle-left" title="Show / hide layers" aria-label="Show / hide layers" data-i18n-title="topbar.toggleLayers" data-i18n-aria="topbar.toggleLayers">
      <svg viewBox="0 0 24 24"><use href="#i-layers"></use></svg>
    </button>
    <button class="tb-icon panel-toggle" id="btn-toggle-right" title="Show / hide tools" aria-label="Show / hide tools" data-i18n-title="topbar.toggleTools" data-i18n-aria="topbar.toggleTools">
      <svg viewBox="0 0 24 24"><use href="#i-adjust"></use></svg>
    </button>
    <span class="topbar-sep" aria-hidden="true"></span>

    <!-- Ordre demandé : Exporter, puis Préférences tout à droite. -->
    <button class="tb-btn tb-export" id="btn-export" title="Export (Ctrl+S)" data-i18n-title="topbar.exportTitle">
      <svg viewBox="0 0 24 24"><use href="#i-export"></use></svg>
      <span data-i18n="topbar.export">Export</span>
    </button>
    <button class="tb-icon prefs-toggle" id="btn-preferences" title="Preferences (Ctrl+,)" aria-label="Open preferences" data-i18n-title="topbar.preferences" data-i18n-aria="topbar.openPreferences">
      <span class="gear-glyph" aria-hidden="true">⚙</span>
    </button>
  </div>
</header>
