---
import BrandMark from './BrandMark.astro';
---
<header class="topbar">
  <div class="brand" aria-label="SuperPhoto">
    <span class="brand-mark" aria-hidden="true">
      <BrandMark decorative />
    </span>
  </div>

  <nav class="topbar-actions" aria-label="Fichier">
    <button class="tb-btn" id="btn-new" title="Nouveau document (Ctrl+N)">
      <svg viewBox="0 0 24 24"><use href="#i-new"></use></svg>
      <span>Nouveau</span>
    </button>
    <button class="tb-btn" id="btn-open" title="Ouvrir une image (Ctrl+O)">
      <svg viewBox="0 0 24 24"><use href="#i-open"></use></svg>
      <span>Ouvrir</span>
    </button>
    <button class="tb-btn" id="btn-export" title="Exporter (Ctrl+S)">
      <svg viewBox="0 0 24 24"><use href="#i-export"></use></svg>
      <span>Exporter</span>
    </button>
    <span class="topbar-sep" aria-hidden="true"></span>
    <button class="tb-icon" id="btn-undo" title="Annuler (Ctrl+Z)" aria-label="Annuler" disabled>
      <svg viewBox="0 0 24 24"><use href="#i-undo"></use></svg>
    </button>
    <button class="tb-icon" id="btn-redo" title="Rétablir (Ctrl+Y)" aria-label="Rétablir" disabled>
      <svg viewBox="0 0 24 24"><use href="#i-redo"></use></svg>
    </button>
  </nav>

  <div class="doc-identity" aria-live="polite">
    <span class="doc-name" id="doc-name">Aucun document</span>
    <span class="doc-meta" id="doc-meta">—</span>
  </div>

  <div class="topbar-tools">
    <div class="color-stack" title="Couleurs principale et secondaire">
      <button class="swatch swatch-primary" id="primary-swatch" aria-label="Couleur principale"></button>
      <button class="swatch swatch-secondary" id="secondary-swatch" aria-label="Couleur secondaire"></button>
      <button class="swatch-swap" id="swap-colors" title="Inverser les couleurs (X)" aria-label="Inverser les couleurs">
        <svg viewBox="0 0 24 24"><use href="#i-swap"></use></svg>
      </button>
      <input type="color" id="primary-color-input" class="native-color" value="#ff8a3d" tabindex="-1" />
      <input type="color" id="secondary-color-input" class="native-color" value="#111114" tabindex="-1" />
    </div>

    <span class="topbar-sep" aria-hidden="true"></span>
    <button class="tb-icon theme-toggle" id="btn-theme-toggle" title="Basculer clair / sombre" aria-label="Basculer entre le thème clair et le thème sombre">
      <svg class="theme-icon-sun" viewBox="0 0 24 24"><use href="#i-sun"></use></svg>
      <svg class="theme-icon-moon" viewBox="0 0 24 24"><use href="#i-moon"></use></svg>
    </button>
    <button class="tb-icon prefs-toggle" id="btn-preferences" title="Préférences (Ctrl+,)" aria-label="Ouvrir les préférences">
      <span class="gear-glyph" aria-hidden="true">⚙</span>
    </button>
    <span class="topbar-sep" aria-hidden="true"></span>
    <button class="tb-icon panel-toggle" id="btn-toggle-left" title="Afficher / masquer les calques" aria-label="Afficher ou masquer les calques">
      <svg viewBox="0 0 24 24"><use href="#i-layers"></use></svg>
    </button>
    <button class="tb-icon panel-toggle" id="btn-toggle-right" title="Afficher / masquer les outils" aria-label="Afficher ou masquer les outils">
      <svg viewBox="0 0 24 24"><use href="#i-adjust"></use></svg>
    </button>
  </div>
</header>
