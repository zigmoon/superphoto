---
import BrandMark from './BrandMark.astro';
---
<div class="modal-backdrop is-open" id="new-document-modal" role="presentation">
  <div class="dialog new-doc-dialog" role="dialog" aria-modal="true" aria-labelledby="new-doc-title">
    <header class="dialog-head">
      <div class="dialog-kicker">
        <span class="kicker-mark"><BrandMark decorative /></span>
        SUPERPHOTO
      </div>
      <h2 id="new-doc-title" data-i18n="new.title">New document</h2>
      <p data-i18n="new.subtitle">Pick a size in pixels, or open an image from your computer.</p>
      <button class="dialog-close" id="new-close" aria-label="Close" data-i18n-aria="common.close">
        <svg viewBox="0 0 24 24"><use href="#i-close"></use></svg>
      </button>
    </header>

    <div class="dialog-body new-doc-body">
      <section class="preset-pane" aria-label="Presets" data-i18n-aria="new.presets">
        <div class="pane-label" data-i18n="new.presets">Presets</div>
        <div class="preset-grid">
          <button class="preset-card is-active" data-preset="screen" data-width="1920" data-height="1080" data-dpi="72">
            <span class="preset-icon"><svg viewBox="0 0 24 24"><use href="#i-image-size"></use></svg></span>
            <strong data-i18n="preset.screen">HD screen</strong>
            <small>1920 × 1080 · 72 dpi</small>
          </button>
          <button class="preset-card" data-preset="photo" data-width="3000" data-height="2000" data-dpi="300">
            <span class="preset-icon"><svg viewBox="0 0 24 24"><use href="#i-image-size"></use></svg></span>
            <strong data-i18n="preset.photo">Photo 6 Mpx</strong>
            <small>3000 × 2000 · 300 dpi</small>
          </button>
          <button class="preset-card" data-preset="a4" data-width="2480" data-height="3508" data-dpi="300">
            <span class="preset-icon"><svg viewBox="0 0 24 24"><use href="#i-canvas-size"></use></svg></span>
            <strong data-i18n="preset.a4">A4 300 dpi</strong>
            <small>2480 × 3508 · 300 dpi</small>
          </button>
          <button class="preset-card" data-preset="square" data-width="2048" data-height="2048" data-dpi="72">
            <span class="preset-icon"><svg viewBox="0 0 24 24"><use href="#i-marquee"></use></svg></span>
            <strong data-i18n="preset.square">Square</strong>
            <small>2048 × 2048 · 72 dpi</small>
          </button>
          <button class="preset-card" data-preset="uhd" data-width="3840" data-height="2160" data-dpi="72">
            <span class="preset-icon"><svg viewBox="0 0 24 24"><use href="#i-image-size"></use></svg></span>
            <strong data-i18n="preset.uhd">Ultra HD</strong>
            <small>3840 × 2160 · 72 dpi</small>
          </button>
          <button class="preset-card" data-preset="portrait" data-width="1200" data-height="1600" data-dpi="300">
            <span class="preset-icon"><svg viewBox="0 0 24 24"><use href="#i-canvas-size"></use></svg></span>
            <strong data-i18n="preset.portrait">Portrait</strong>
            <small>1200 × 1600 · 300 dpi</small>
          </button>
        </div>
      </section>

      <section class="settings-pane" aria-label="Custom format" data-i18n-aria="new.custom">
        <div class="pane-label" data-i18n="new.custom">Custom format</div>

        <div class="new-doc-fields">
          <label class="unit-field">
            <span data-i18n="new.width">Width</span>
            <div class="unit-input">
              <input type="number" id="new-width" min="1" max="16384" step="1" value="1920" inputmode="numeric" />
              <em>px</em>
            </div>
          </label>
          <label class="unit-field">
            <span data-i18n="new.height">Height</span>
            <div class="unit-input">
              <input type="number" id="new-height" min="1" max="16384" step="1" value="1080" inputmode="numeric" />
              <em>px</em>
            </div>
          </label>
        </div>

        <div class="new-doc-row">
          <label class="unit-field">
            <span data-i18n="new.resolution">Resolution</span>
            <div class="unit-input">
              <input type="number" id="new-dpi" min="1" max="1200" step="1" value="72" inputmode="numeric" />
              <em data-i18n="common.dpi">dpi</em>
            </div>
          </label>
          <button class="ratio-lock" id="new-ratio-lock" aria-pressed="false" title="Keep proportions" data-i18n-title="new.keepRatio">
            <svg viewBox="0 0 24 24"><use href="#i-lock"></use></svg>
            <span data-i18n="new.keepRatio">Keep proportions</span>
          </button>
        </div>

        <div class="new-doc-pair">
          <div>
            <div class="pane-label" data-i18n="new.background">Background</div>
            <div class="segmented" id="new-background">
              <button data-bg="white" class="is-active" data-i18n="new.white">White</button>
              <button data-bg="transparent" data-i18n="new.transparent">Transparent</button>
              <button data-bg="black" data-i18n="new.black">Black</button>
            </div>
          </div>
          <div>
            <div class="pane-label" data-i18n="mode.title">Colour mode</div>
            <div class="segmented" id="new-color-mode">
              <button data-mode="rgb" class="is-active" data-i18n="mode.rgb">RGB</button>
              <button data-mode="cmyk" data-i18n="mode.cmyk">CMYK</button>
              <button data-mode="gray" data-i18n="mode.gray">B&amp;W</button>
            </div>
          </div>
        </div>
      </section>

      <!-- Bandeau commun aux deux colonnes : la forme du document à gauche, sa
           fiche à droite. Il ferme la boîte, donc plus de vide en bas à gauche. -->
      <div class="new-preview-bar">
        <div class="new-preview-stage">
          <div class="new-preview-box" id="new-preview-box"></div>
        </div>
        <div class="new-preview-info">
          <span class="new-preview-label" id="new-preview-label">1920 × 1080 px · 72 dpi</span>
          <p class="preset-note" data-i18n="new.note">
            You can drop images straight from your desktop onto the canvas.
          </p>
        </div>
      </div>
    </div>

    <footer class="dialog-foot">
      <button class="btn ghost" id="new-open-computer">
        <svg viewBox="0 0 24 24"><use href="#i-open"></use></svg>
        <span data-i18n="new.openComputer">Open from computer</span>
      </button>
      <div class="foot-spacer"></div>
      <button class="btn ghost" id="new-cancel" data-i18n="common.cancel">Cancel</button>
      <button class="btn primary" id="new-create">
        <svg viewBox="0 0 24 24"><use href="#i-check"></use></svg>
        <span data-i18n="new.create">Create</span>
      </button>
    </footer>
  </div>
</div>
