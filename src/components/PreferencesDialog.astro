---
import BrandMark from './BrandMark.astro';
---
<div class="modal-backdrop" id="preferences-modal" role="presentation">
  <div class="dialog preferences-dialog" role="dialog" aria-modal="true" aria-labelledby="prefs-title">
    <header class="dialog-head compact prefs-head">
      <span class="prefs-gear" aria-hidden="true">⚙</span>
      <div class="prefs-head-copy">
        <div class="dialog-kicker">SUPERPHOTO</div>
        <h2 id="prefs-title" data-i18n="prefs.title">Preferences</h2>
        <p data-i18n="prefs.subtitle">Appearance, canvas, rendering and shortcuts. Settings are kept on this device.</p>
      </div>
      <button class="dialog-close" id="prefs-close" aria-label="Close" data-i18n-aria="common.close">
        <svg viewBox="0 0 24 24"><use href="#i-close"></use></svg>
      </button>
    </header>

    <div class="prefs-tabs" role="tablist" aria-label="Preferences sections">
      <button class="prefs-tab is-active" role="tab" aria-selected="true" data-prefs-tab="appearance" data-i18n="prefs.tab.appearance">Appearance</button>
      <button class="prefs-tab" role="tab" aria-selected="false" data-prefs-tab="canvas" data-i18n="prefs.tab.canvas">Canvas</button>
      <button class="prefs-tab" role="tab" aria-selected="false" data-prefs-tab="shortcuts" data-i18n="prefs.tab.shortcuts">Shortcuts</button>
      <button class="prefs-tab" role="tab" aria-selected="false" data-prefs-tab="plugins" data-i18n="prefs.tab.plugins">Plug-ins</button>
      <button class="prefs-tab" role="tab" aria-selected="false" data-prefs-tab="about" data-i18n="prefs.tab.about">About</button>
    </div>

    <div class="dialog-body prefs-body">
      <section class="prefs-panel" data-prefs-panel="appearance">
        <div class="prefs-section">
          <div class="prefs-section-title" data-i18n="prefs.language">Language</div>
          <div class="prefs-section-hint" data-i18n="prefs.languageHint">
            Detected from your browser on first launch. Your choice is remembered.
          </div>
          <div class="prefs-choice-row compact" data-lang-row>
            <button class="prefs-choice" data-lang="en"><span>English</span></button>
            <button class="prefs-choice" data-lang="fr"><span>Français</span></button>
            <button class="prefs-choice" data-lang="ja"><span>日本語</span></button>
          </div>
        </div>

        <div class="prefs-section">
          <div class="prefs-section-title" data-i18n="prefs.theme">Theme</div>
          <div class="prefs-section-hint" data-i18n="prefs.themeHint">
            Light follows the SuperPrint palette; dark is the photo studio.
          </div>
          <div class="prefs-choice-row" data-pref="theme">
            <button class="prefs-choice" data-value="light">
              <svg viewBox="0 0 24 24"><use href="#i-sun"></use></svg>
              <span data-i18n="prefs.light">Light</span>
            </button>
            <button class="prefs-choice" data-value="dark">
              <svg viewBox="0 0 24 24"><use href="#i-moon"></use></svg>
              <span data-i18n="prefs.dark">Dark</span>
            </button>
            <button class="prefs-choice" data-value="system">
              <svg viewBox="0 0 24 24"><use href="#i-desktop"></use></svg>
              <span data-i18n="prefs.system">System</span>
            </button>
          </div>
        </div>

        <div class="prefs-section">
          <div class="prefs-section-title" data-i18n="prefs.motion">Animations</div>
          <div class="prefs-section-hint" data-i18n="prefs.motionHint">
            Reduced: no transition, no pulsing. The interface responds instantly.
          </div>
          <div class="prefs-choice-row compact" data-pref="motion">
            <button class="prefs-choice" data-value="full"><span data-i18n="prefs.motionFull">Normal</span></button>
            <button class="prefs-choice" data-value="reduced"><span data-i18n="prefs.motionReduced">Reduced</span></button>
          </div>
        </div>
      </section>

      <section class="prefs-panel" data-prefs-panel="canvas" hidden>
        <div class="prefs-section">
          <div class="prefs-section-title" data-i18n="prefs.checker">Transparency checker</div>
          <div class="prefs-section-hint" data-i18n="prefs.checkerHint">
            The backdrop behind transparent areas of the image.
          </div>
          <div class="prefs-choice-row compact" data-pref="checker">
            <button class="prefs-choice" data-value="auto"><span data-i18n="prefs.auto">Automatic</span></button>
            <button class="prefs-choice" data-value="light"><span data-i18n="prefs.light">Light</span></button>
            <button class="prefs-choice" data-value="dark"><span data-i18n="prefs.dark">Dark</span></button>
          </div>
        </div>

        <div class="prefs-section">
          <div class="prefs-section-title" data-i18n="prefs.quality">Render quality</div>
          <div class="prefs-section-hint" data-i18n="prefs.qualityHint">
            Fast favours fluidity on very large images; precise refines resampling.
          </div>
          <div class="prefs-choice-row compact" data-pref="quality">
            <button class="prefs-choice" data-value="fast"><span data-i18n="prefs.fast">Fast</span></button>
            <button class="prefs-choice" data-value="balanced"><span data-i18n="prefs.balanced">Balanced</span></button>
            <button class="prefs-choice" data-value="precise"><span data-i18n="prefs.precise">Precise</span></button>
          </div>
        </div>

        <div class="prefs-section">
          <div class="prefs-section-title" data-i18n="prefs.display">Display</div>
          <label class="prefs-switch">
            <span>
              <strong data-i18n="prefs.coordinates">Cursor coordinates</strong>
              <small data-i18n="prefs.coordinatesHint">Shows x / y in the status bar.</small>
            </span>
            <input type="checkbox" data-pref-toggle="coordinates" />
          </label>
          <label class="prefs-switch">
            <span>
              <strong data-i18n="prefs.smoothZoom">Smooth zoom</strong>
              <small data-i18n="prefs.smoothZoomHint">Off: pixels stay crisp beyond 400 %.</small>
            </span>
            <input type="checkbox" data-pref-toggle="smoothZoom" />
          </label>
          <label class="prefs-switch">
            <span>
              <strong data-i18n="prefs.autoFit">Fit on resize</strong>
              <small data-i18n="prefs.autoFitHint">Refits the view when the window changes size.</small>
            </span>
            <input type="checkbox" data-pref-toggle="autoFit" />
          </label>
        </div>

        <div class="prefs-section">
          <div class="prefs-section-title" data-i18n="prefs.session">Session</div>
          <label class="prefs-switch">
            <span>
              <strong data-i18n="prefs.autosave">Automatic save</strong>
              <small id="prefs-session-state">No session saved yet.</small>
            </span>
            <input type="checkbox" data-pref-toggle="autosave" />
          </label>
          <div class="button-row">
            <button class="btn ghost sm" id="prefs-forget-session" data-i18n="prefs.forget">Forget the saved session</button>
          </div>
        </div>
      </section>

      <section class="prefs-panel" data-prefs-panel="shortcuts" hidden>
        <p class="prefs-section-hint" data-i18n="prefs.shortcutsHint">
          Every keyboard combination, grouped by tool, file and view.
        </p>
        <div class="prefs-section">
          <div class="prefs-section-title" data-i18n="sc.tools">Tools</div>
          <div class="shortcut-grid">
            <span><kbd>V</kbd> <em data-i18n="tool.select.label">Select</em></span>
            <span><kbd>M</kbd> <em data-i18n="tool.marquee.label">Marquee</em></span>
            <span><kbd>W</kbd> <em data-i18n="tool.magic-wand.label">Magic wand</em></span>
            <span><kbd>C</kbd> <em data-i18n="tool.crop.label">Crop</em></span>
            <span><kbd>U</kbd> <em data-i18n="tool.shapes.label">Shapes</em></span>
            <span><kbd>P</kbd> <em data-i18n="tool.pen.label">Pen</em></span>
            <span><kbd>T</kbd> <em data-i18n="tool.text.label">Text</em></span>
            <span><kbd>N</kbd> <em data-i18n="tool.pencil.label">Pencil</em></span>
            <span><kbd>B</kbd> <em data-i18n="tool.brush.label">Brush</em></span>
            <span><kbd>E</kbd> <em data-i18n="tool.eraser.label">Eraser</em></span>
            <span><kbd>S</kbd> <em data-i18n="tool.stamp.label">Clone stamp</em></span>
            <span><kbd>J</kbd> <em data-i18n="tool.patch.label">Patch</em></span>
            <span><kbd>K</kbd> <em data-i18n="tool.heal.label">Healing brush</em></span>
            <span><kbd>L</kbd> <em data-i18n="tool.spotlight.label">Light spot</em></span>
            <span><kbd>I</kbd> <em data-i18n="tool.eyedropper.label">Eyedropper</em></span>
            <span><kbd>G</kbd> <em data-i18n="tool.gradient.label">Gradient</em></span>
            <span><kbd>Z</kbd> <em data-i18n="tool.zoom.label">Zoom</em></span>
            <span><kbd>H</kbd> <em data-i18n="tool.hand.label">Hand</em></span>
            <span><kbd>[</kbd> <kbd>]</kbd> <em data-i18n="sc.brushSize">Brush size (or pencil)</em></span>
            <span><kbd>Alt</kbd> <em data-i18n="sc.alt">Stamp source · temporary eraser · secondary color</em></span>
            <span><kbd>Space</kbd> <em data-i18n="sc.space">Temporary hand</em></span>
            <span><kbd>Esc</kbd> <em data-i18n="sc.escape">Cancel the adjustment, crop or selection</em></span>
          </div>
        </div>
        <div class="prefs-section">
          <div class="prefs-section-title" data-i18n="prefs.group.file">File</div>
          <div class="shortcut-grid">
            <span><kbd>Ctrl N</kbd> <em data-i18n="sc.new">New document</em></span>
            <span><kbd>Ctrl O</kbd> <em data-i18n="sc.open">Open an image</em></span>
            <span><kbd>Ctrl S</kbd> <em data-i18n="sc.export">Export</em></span>
            <span><kbd>Ctrl ,</kbd> <em data-i18n="sc.prefs">Preferences</em></span>
            <span><kbd>Ctrl W</kbd> <em data-i18n="sc.closeTab">Close the current tab</em></span>
            <span><kbd>Ctrl ⇥</kbd> <em data-i18n="sc.nextTab">Next / previous tab</em></span>
            <span><kbd>Ctrl Z</kbd> <em data-i18n="sc.undo">Undo</em></span>
            <span><kbd>Ctrl ⇧ Z</kbd> <kbd>Ctrl Y</kbd> <em data-i18n="sc.redo">Redo</em></span>
            <span><kbd>F1</kbd> <kbd>?</kbd> <em data-i18n="sc.help">Show this shortcut list</em></span>
          </div>
        </div>
        <div class="prefs-section">
          <div class="prefs-section-title" data-i18n="prefs.group.layers">Layers &amp; selection</div>
          <div class="shortcut-grid">
            <span><kbd>Suppr</kbd> <em data-i18n="sc.delete">Delete the layer (no selection)</em></span>
            <span><kbd>⇧ Suppr</kbd> <em data-i18n="sc.clearLayer">Clear the layer content</em></span>
            <span><kbd>Ctrl ⇧ N</kbd> <em data-i18n="sc.newLayer">New layer</em></span>
            <span><kbd>Ctrl J</kbd> <em data-i18n="sc.duplicateLayer">Duplicate the layer</em></span>
            <span><kbd>Ctrl E</kbd> <em data-i18n="sc.mergeDown">Merge down</em></span>
            <span><kbd>Ctrl [</kbd> / <kbd>Ctrl ]</kbd> <em data-i18n="sc.reorderLayer">Move the layer up / down</em></span>
            <span><kbd>Alt [</kbd> / <kbd>Alt ]</kbd> <em data-i18n="sc.selectLayer">Select the layer above / below</em></span>
            <span><kbd>←↑→↓</kbd> <em data-i18n="sc.nudge">Nudge by 1 px (Shift: 10 px)</em></span>
            <span><kbd>Ctrl T</kbd> <em data-i18n="sc.transform">Free transform: box and handles</em></span>
            <span><kbd>Ctrl A</kbd> <em data-i18n="sc.selectAll">Select all</em></span>
            <span><kbd>Ctrl D</kbd> <em data-i18n="sc.deselect">Deselect</em></span>
            <span><kbd>Ctrl ⇧ I</kbd> <em data-i18n="sc.invertSelection">Invert the selection</em></span>
            <span><kbd>Alt ⌫</kbd> <em data-i18n="sc.fill">Fill the selection with the primary color</em></span>
            <span><kbd>Ctrl ⌫</kbd> <em data-i18n="sc.fillSecondary">Fill the selection with the secondary color</em></span>
          </div>
        </div>
        <div class="prefs-section">
          <div class="prefs-section-title" data-i18n="prefs.group.view">View</div>
          <div class="shortcut-grid">
            <span><kbd>Ctrl 0</kbd> <em data-i18n="sc.fit">Fit to window</em></span>
            <span><kbd>Ctrl 1</kbd> <em data-i18n="sc.zoom100">Zoom 100 %</em></span>
            <span><kbd>Ctrl +</kbd> / <kbd>Ctrl −</kbd> <em data-i18n="sc.zoomInOut">Zoom in / out</em></span>
            <span><kbd>F11</kbd> <em data-i18n="sc.fullscreen">Full screen</em></span>
            <span><kbd>X</kbd> <em data-i18n="sc.swapColors">Swap colors</em></span>
            <span><kbd>D</kbd> <em data-i18n="sc.resetColors">Default colors</em></span>
          </div>
        </div>
      </section>

      <section class="prefs-panel" data-prefs-panel="plugins" hidden>
        <p class="prefs-section-hint" data-i18n="prefs.pluginsHint">
          Plug-ins extend the tools without changing the core. An enabled plug-in adds
          its icon to the top bar. Everything runs locally.
        </p>
        <div class="plugin-list" id="prefs-plugin-list"></div>
        <div class="prefs-section">
          <div class="prefs-section-title" data-i18n="prefs.pluginsDev">Adding a plug-in</div>
          <div class="prefs-section-hint" data-i18n="prefs.pluginsDevHint">
            A plug-in is a recorded entry in src/lib/plugins.ts: a list of effects, each
            one a pure pixel function with its own sliders. No build step, no network.
          </div>
        </div>
      </section>

      <section class="prefs-panel" data-prefs-panel="about" hidden>
        <div class="about-card">
          <div class="about-brand">
            <span class="about-mark"><BrandMark decorative /></span>
            <div>
              <strong>SUPERPHOTO</strong>
              <small>PHOTO STUDIO · v{__APP_VERSION__}</small>
            </div>
          </div>
          <p data-i18n="stage.emptyBody">
            Open an image or create a canvas to start. Layers, selections, curves,
            levels and Bézier paths await you in a fast, precise workspace.
          </p>
        </div>

        <div class="prefs-section">
          <div class="prefs-section-title" data-i18n="prefs.aboutTech">Technologies</div>
          <div class="about-grid">
            <span data-i18n="about.interface">Interface</span><strong>Astro 7 · TypeScript</strong>
            <span data-i18n="about.engine">Desktop engine</span><strong>Rust · Tauri 2</strong>
            <span data-i18n="about.render">Rendering</span><strong>Canvas 2D</strong>
            <span data-i18n="about.formats">Formats</span><strong>PNG · JPEG · WebP · AVIF · TIFF · SVG · .SPS</strong>
            <span data-i18n="about.platforms">Platforms</span><strong>Windows · macOS · Linux</strong>
          </div>
        </div>

        <div class="prefs-section">
          <div class="prefs-section-title" data-i18n="prefs.aboutCredits">Credits</div>
          <div class="about-grid">
            <span data-i18n="about.design">Design</span><strong>Simon Dupont-Gellert · Clémence Brunet</strong>
            <span data-i18n="about.studio">Studio</span><strong>SuperPhoto / SuperPrint</strong>
            <span data-i18n="about.license">License</span><strong>MIT</strong>
          </div>
        </div>
      </section>
    </div>

    <footer class="dialog-foot prefs-foot">
      <button class="btn ghost" id="prefs-reset" data-i18n="common.reset">Reset</button>
      <div class="foot-spacer"></div>
      <button class="btn ghost" id="prefs-cancel" data-i18n="common.cancel">Cancel</button>
      <button class="btn primary" id="prefs-apply">
        <svg viewBox="0 0 24 24"><use href="#i-check"></use></svg>
        <span data-i18n="common.apply">Apply</span>
      </button>
    </footer>
  </div>
</div>
