<footer class="statusbar" aria-live="polite">
  <div class="status-left">
    <span class="status-tool" id="status-tool">Sélection</span>
    <span class="status-dot" aria-hidden="true"></span>
    <span class="status-message" id="status-message">Prêt</span>
  </div>
  <div class="status-right">
    <span id="status-autosave" class="status-autosave" title="Sauvegarde automatique">
      <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-save"></use></svg>
      <span id="status-autosave-text">Auto</span>
    </span>
    <span class="status-dot" aria-hidden="true"></span>
    <span id="status-layer">Aucun calque</span>
    <span class="status-dot" aria-hidden="true"></span>
    <span id="status-selection">Aucune sélection</span>
    <span class="status-dot" id="status-pos-dot" aria-hidden="true"></span>
    <span id="status-pos">x — · y —</span>
    <span class="status-zoom" id="status-zoom">100 %</span>
  </div>
</footer>
