<aside class="sidebar tools-sidebar" id="tools-sidebar" aria-label="Tools and settings">
  <div class="sidebar-head">
    <div>
      <span class="eyebrow" data-i18n="opt.studio">Studio</span>
      <h2 data-i18n="opt.tools">Tools</h2>
    </div>
    <span class="shortcut-hint">V M W B E S J L</span>
  </div>

  <div class="tool-scroll">
    <div class="tool-group">
      <div class="section-title" data-i18n="opt.groupDraw">Selection &amp; drawing</div>
      <div class="tool-grid">
        <button class="tool-card" data-tool="select" title="Select (V)" data-i18n-title="tool.select.label">
          <svg viewBox="0 0 24 24"><use href="#i-select"></use></svg>
          <span data-i18n="tool.select.label">Select</span>
          <kbd>V</kbd>
        </button>
        <button class="tool-card" data-tool="marquee" title="Marquee (M)" data-i18n-title="tool.marquee.label">
          <svg viewBox="0 0 24 24"><use href="#i-marquee"></use></svg>
          <span data-i18n="tool.marquee.label">Marquee</span>
          <kbd>M</kbd>
        </button>
        <button class="tool-card" data-tool="magic-wand" title="Magic wand (W)" data-i18n-title="tool.magic-wand.label">
          <svg viewBox="0 0 24 24"><use href="#i-wand"></use></svg>
          <span data-i18n="tool.magic-wand.label">Magic wand</span>
          <kbd>W</kbd>
        </button>
        <button class="tool-card" data-tool="crop" title="Crop (C)" data-i18n-title="tool.crop.label">
          <svg viewBox="0 0 24 24"><use href="#i-crop"></use></svg>
          <span data-i18n="tool.crop.label">Crop</span>
          <kbd>C</kbd>
        </button>
        <button class="tool-card" data-tool="shapes" title="Shapes (U)" data-i18n-title="tool.shapes.label">
          <svg viewBox="0 0 24 24"><use href="#i-shapes"></use></svg>
          <span data-i18n="tool.shapes.label">Shapes</span>
          <kbd>U</kbd>
        </button>
        <button class="tool-card" data-tool="pen" title="Pen (P)" data-i18n-title="tool.pen.label">
          <svg viewBox="0 0 24 24"><use href="#i-pen"></use></svg>
          <span data-i18n="tool.pen.label">Pen</span>
          <kbd>P</kbd>
        </button>
        <button class="tool-card" data-tool="text" title="Text (T)" data-i18n-title="tool.text.label">
          <svg viewBox="0 0 24 24"><use href="#i-text"></use></svg>
          <span data-i18n="tool.text.label">Text</span>
          <kbd>T</kbd>
        </button>
        <button class="tool-card" data-tool="pencil" title="Pencil (N)" data-i18n-title="tool.pencil.label">
          <svg viewBox="0 0 24 24"><use href="#i-pencil"></use></svg>
          <span data-i18n="tool.pencil.label">Pencil</span>
          <kbd>N</kbd>
        </button>
        <button class="tool-card" data-tool="brush" title="Brush (B)" data-i18n-title="tool.brush.label">
          <svg viewBox="0 0 24 24"><use href="#i-brush"></use></svg>
          <span data-i18n="tool.brush.label">Brush</span>
          <kbd>B</kbd>
        </button>
        <button class="tool-card" data-tool="eraser" title="Eraser (E)" data-i18n-title="tool.eraser.label">
          <svg viewBox="0 0 24 24"><use href="#i-eraser"></use></svg>
          <span data-i18n="tool.eraser.label">Eraser</span>
          <kbd>E</kbd>
        </button>
        <button class="tool-card" data-tool="stamp" title="Clone stamp (S)" data-i18n-title="tool.stamp.label">
          <svg viewBox="0 0 24 24"><use href="#i-stamp"></use></svg>
          <span data-i18n="tool.stamp.label">Clone stamp</span>
          <kbd>S</kbd>
        </button>
        <button class="tool-card" data-tool="patch" title="Patch (J)" data-i18n-title="tool.patch.label">
          <svg viewBox="0 0 24 24"><use href="#i-patch"></use></svg>
          <span data-i18n="tool.patch.label">Patch</span>
          <kbd>J</kbd>
        </button>
        <button class="tool-card" data-tool="heal" title="Healing brush (K)" data-i18n-title="tool.heal.label">
          <svg viewBox="0 0 24 24"><use href="#i-heal"></use></svg>
          <span data-i18n="tool.heal.label">Healing brush</span>
          <kbd>K</kbd>
        </button>
        <button class="tool-card" data-tool="spotlight" title="Light spot (L)" data-i18n-title="tool.spotlight.label">
          <svg viewBox="0 0 24 24"><use href="#i-spotlight"></use></svg>
          <span data-i18n="tool.spotlight.label">Light spot</span>
          <kbd>L</kbd>
        </button>
        <button class="tool-card" data-tool="eyedropper" title="Eyedropper (I)" data-i18n-title="tool.eyedropper.label">
          <svg viewBox="0 0 24 24"><use href="#i-eyedropper"></use></svg>
          <span data-i18n="tool.eyedropper.label">Eyedropper</span>
          <kbd>I</kbd>
        </button>
        <button class="tool-card" data-tool="gradient" title="Gradient (G)" data-i18n-title="tool.gradient.label">
          <svg viewBox="0 0 24 24"><use href="#i-gradient"></use></svg>
          <span data-i18n="tool.gradient.label">Gradient</span>
          <kbd>G</kbd>
        </button>
        <button class="tool-card" data-tool="zoom" title="Zoom (Z)" data-i18n-title="tool.zoom.label">
          <svg viewBox="0 0 24 24"><use href="#i-zoom"></use></svg>
          <span data-i18n="tool.zoom.label">Zoom</span>
          <kbd>Z</kbd>
        </button>
        <button class="tool-card" data-tool="hand" title="Hand (H)" data-i18n-title="tool.hand.label">
          <svg viewBox="0 0 24 24"><use href="#i-hand"></use></svg>
          <span data-i18n="tool.hand.label">Hand</span>
          <kbd>H</kbd>
        </button>
      </div>
    </div>

    <!-- Options de l'outil en cours : juste sous Zoom et Main, là où l'œil
         revient après avoir choisi un outil. Les réglages d'image restent
         plus bas, dans leur propre groupe. -->
    <div class="tool-options" id="tool-options">
      <div class="options-head">
        <span class="eyebrow" data-i18n="opt.options">Options</span>
        <h3 id="tool-options-title">Select</h3>
      </div>
      <div class="options-body" id="tool-options-body">
        <p class="options-hint">Select a tool.</p>
      </div>
    </div>

    <div class="tool-group">
      <div class="section-title" data-i18n="opt.align">Alignment</div>
      <div class="align-block">
        <span class="align-label" data-i18n="opt.alignCanvas">Align on the canvas</span>
        <div class="align-row" role="group" aria-labelledby="align-canvas-label">
          <button class="align-btn" data-align-object="left" title="Left" data-i18n-title="opt.alignLeftShort" aria-label="Left"><svg viewBox="0 0 24 24"><use href="#i-align-left"></use></svg></button>
          <button class="align-btn" data-align-object="center" title="Center" data-i18n-title="opt.alignCenterShort" aria-label="Center"><svg viewBox="0 0 24 24"><use href="#i-align-center"></use></svg></button>
          <button class="align-btn" data-align-object="right" title="Right" data-i18n-title="opt.alignRightShort" aria-label="Right"><svg viewBox="0 0 24 24"><use href="#i-align-right"></use></svg></button>
          <button class="align-btn" data-align-object="top" title="Top" data-i18n-title="opt.alignTopShort" aria-label="Top"><svg viewBox="0 0 24 24"><use href="#i-align-top"></use></svg></button>
          <button class="align-btn" data-align-object="middle" title="Middle" data-i18n-title="opt.alignMiddleShort" aria-label="Middle"><svg viewBox="0 0 24 24"><use href="#i-align-middle"></use></svg></button>
          <button class="align-btn" data-align-object="bottom" title="Bottom" data-i18n-title="opt.alignBottomShort" aria-label="Bottom"><svg viewBox="0 0 24 24"><use href="#i-align-bottom"></use></svg></button>
        </div>
      </div>
      <div class="align-block">
        <span class="align-label" data-i18n="opt.alignObjects">Align between objects</span>
        <div class="align-row" role="group">
          <button class="align-btn" data-align-objects="left" title="Left" data-i18n-title="opt.alignLeftShort" aria-label="Left"><svg viewBox="0 0 24 24"><use href="#i-align-left"></use></svg></button>
          <button class="align-btn" data-align-objects="center" title="Center" data-i18n-title="opt.alignCenterShort" aria-label="Center"><svg viewBox="0 0 24 24"><use href="#i-align-center"></use></svg></button>
          <button class="align-btn" data-align-objects="right" title="Right" data-i18n-title="opt.alignRightShort" aria-label="Right"><svg viewBox="0 0 24 24"><use href="#i-align-right"></use></svg></button>
          <button class="align-btn" data-align-objects="top" title="Top" data-i18n-title="opt.alignTopShort" aria-label="Top"><svg viewBox="0 0 24 24"><use href="#i-align-top"></use></svg></button>
          <button class="align-btn" data-align-objects="middle" title="Middle" data-i18n-title="opt.alignMiddleShort" aria-label="Middle"><svg viewBox="0 0 24 24"><use href="#i-align-middle"></use></svg></button>
          <button class="align-btn" data-align-objects="bottom" title="Bottom" data-i18n-title="opt.alignBottomShort" aria-label="Bottom"><svg viewBox="0 0 24 24"><use href="#i-align-bottom"></use></svg></button>
        </div>
      </div>
    </div>

    <div class="tool-group">
      <div class="section-title" data-i18n="opt.image">Image</div>
      <div class="wide-tool-list">
        <button class="wide-tool" data-action="image-size" title="Image size" data-i18n-title="resize.imageTitle">
          <svg viewBox="0 0 24 24"><use href="#i-image-size"></use></svg>
          <span data-i18n="resize.imageTitle">Image size</span>
        </button>
        <button class="wide-tool" data-action="canvas-size" title="Canvas size" data-i18n-title="resize.canvasTitle">
          <svg viewBox="0 0 24 24"><use href="#i-canvas-size"></use></svg>
          <span data-i18n="resize.canvasTitle">Canvas size</span>
        </button>
      </div>

      <div class="section-title" data-i18n="mode.title">Colour mode</div>
      <div class="mode-switch" id="color-mode-switch" role="group" aria-labelledby="color-mode-label">
        <button class="mode-btn is-active" data-color-mode="rgb" title="RGB" data-i18n-title="mode.rgbHint">
          <span data-i18n="mode.rgb">RGB</span>
        </button>
        <button class="mode-btn" data-color-mode="cmyk" title="CMYK" data-i18n-title="mode.cmykHint">
          <span data-i18n="mode.cmyk">CMYK</span>
        </button>
        <button class="mode-btn" data-color-mode="gray" title="Grayscale" data-i18n-title="mode.grayHint">
          <span data-i18n="mode.gray">B&amp;W</span>
        </button>
      </div>
      <p class="mode-note" id="color-mode-note" data-i18n="mode.note">
        Switching away from RGB previews the print or grayscale rendering. Switching back to RGB restores the colours.
      </p>
    </div>

    <div class="tool-group">
      <div class="section-title" data-i18n="opt.adjustments">Adjustments</div>
      <div class="wide-tool-list">
        <button class="wide-tool" data-action="adjust-tonality" title="Tonality" data-i18n-title="adjust.tonality">
          <svg viewBox="0 0 24 24"><use href="#i-tonality"></use></svg>
          <span data-i18n="adjust.tonality">Tonality</span>
        </button>
        <button class="wide-tool" data-action="adjust-contrast" title="Contrast" data-i18n-title="adjust.contrast">
          <svg viewBox="0 0 24 24"><use href="#i-contrast"></use></svg>
          <span data-i18n="adjust.contrast">Contrast</span>
        </button>
        <button class="wide-tool" data-action="adjust-color" title="Color" data-i18n-title="adjust.color">
          <svg viewBox="0 0 24 24"><use href="#i-color"></use></svg>
          <span data-i18n="adjust.color">Color</span>
        </button>
        <button class="wide-tool" data-action="adjust-levels" title="Levels" data-i18n-title="adjust.levels">
          <svg viewBox="0 0 24 24"><use href="#i-levels"></use></svg>
          <span data-i18n="adjust.levels">Levels</span>
        </button>
        <button class="wide-tool" data-action="adjust-curves" title="Curves" data-i18n-title="adjust.curves">
          <svg viewBox="0 0 24 24"><use href="#i-curves"></use></svg>
          <span data-i18n="adjust.curves">Curves</span>
        </button>
      </div>
    </div>
  </div>
</aside>
