<aside class="sidebar tools-sidebar" id="tools-sidebar" aria-label="Outils et réglages">
  <div class="sidebar-head">
    <div>
      <span class="eyebrow">Studio</span>
      <h2>Outils</h2>
    </div>
    <span class="shortcut-hint">V C M U P T</span>
  </div>

  <div class="tool-scroll">
    <div class="tool-group">
      <div class="section-title">Sélection &amp; dessin</div>
      <div class="tool-grid">
        <button class="tool-card" data-tool="select" title="Sélection (V)">
          <svg viewBox="0 0 24 24"><use href="#i-select"></use></svg>
          <span>Sélection</span>
          <kbd>V</kbd>
        </button>
        <button class="tool-card" data-tool="marquee" title="Zone de sélection (M)">
          <svg viewBox="0 0 24 24"><use href="#i-marquee"></use></svg>
          <span>Zone</span>
          <kbd>M</kbd>
        </button>
        <button class="tool-card" data-tool="crop" title="Recadrage (C)">
          <svg viewBox="0 0 24 24"><use href="#i-crop"></use></svg>
          <span>Recadrage</span>
          <kbd>C</kbd>
        </button>
        <button class="tool-card" data-tool="shapes" title="Objets et formes (U)">
          <svg viewBox="0 0 24 24"><use href="#i-shapes"></use></svg>
          <span>Objets</span>
          <kbd>U</kbd>
        </button>
        <button class="tool-card" data-tool="pen" title="Plume Bézier (P)">
          <svg viewBox="0 0 24 24"><use href="#i-pen"></use></svg>
          <span>Plume</span>
          <kbd>P</kbd>
        </button>
        <button class="tool-card" data-tool="text" title="Texte (T)">
          <svg viewBox="0 0 24 24"><use href="#i-text"></use></svg>
          <span>Texte</span>
          <kbd>T</kbd>
        </button>
        <button class="tool-card" data-tool="eyedropper" title="Pipette (I)">
          <svg viewBox="0 0 24 24"><use href="#i-eyedropper"></use></svg>
          <span>Pipette</span>
          <kbd>I</kbd>
        </button>
        <button class="tool-card" data-tool="gradient" title="Dégradé (G)">
          <svg viewBox="0 0 24 24"><use href="#i-gradient"></use></svg>
          <span>Dégradé</span>
          <kbd>G</kbd>
        </button>
        <button class="tool-card" data-tool="zoom" title="Zoom (Z)">
          <svg viewBox="0 0 24 24"><use href="#i-zoom"></use></svg>
          <span>Zoom</span>
          <kbd>Z</kbd>
        </button>
        <button class="tool-card" data-tool="hand" title="Main (H)">
          <svg viewBox="0 0 24 24"><use href="#i-hand"></use></svg>
          <span>Main</span>
          <kbd>H</kbd>
        </button>
      </div>
    </div>

    <div class="tool-group">
      <div class="section-title">Image</div>
      <div class="wide-tool-list">
        <button class="wide-tool" data-action="image-size" title="Taille de l’image">
          <svg viewBox="0 0 24 24"><use href="#i-image-size"></use></svg>
          <span>Taille de l’image</span>
        </button>
        <button class="wide-tool" data-action="canvas-size" title="Taille de la zone de travail">
          <svg viewBox="0 0 24 24"><use href="#i-canvas-size"></use></svg>
          <span>Taille de la zone de travail</span>
        </button>
      </div>
    </div>

    <div class="tool-group">
      <div class="section-title">Réglages</div>
      <div class="wide-tool-list">
        <button class="wide-tool" data-action="adjust-tonality" title="Tonalité">
          <svg viewBox="0 0 24 24"><use href="#i-tonality"></use></svg>
          <span>Tonalité</span>
        </button>
        <button class="wide-tool" data-action="adjust-contrast" title="Contraste">
          <svg viewBox="0 0 24 24"><use href="#i-contrast"></use></svg>
          <span>Contraste</span>
        </button>
        <button class="wide-tool" data-action="adjust-color" title="Couleur">
          <svg viewBox="0 0 24 24"><use href="#i-color"></use></svg>
          <span>Couleur</span>
        </button>
        <button class="wide-tool" data-action="adjust-levels" title="Niveaux">
          <svg viewBox="0 0 24 24"><use href="#i-levels"></use></svg>
          <span>Niveaux</span>
        </button>
        <button class="wide-tool" data-action="adjust-curves" title="Courbes">
          <svg viewBox="0 0 24 24"><use href="#i-curves"></use></svg>
          <span>Courbes</span>
        </button>
      </div>
    </div>

    <div class="tool-options" id="tool-options">
      <div class="options-head">
        <span class="eyebrow">Options</span>
        <h3 id="tool-options-title">Sélection</h3>
      </div>
      <div class="options-body" id="tool-options-body">
        <p class="options-hint">Sélectionnez un outil.</p>
      </div>
    </div>
  </div>
</aside>
