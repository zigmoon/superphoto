---
import BrandMark from './BrandMark.astro';
---
<!-- Greffons : trappe ancrée à droite, comme les panneaux de SuperPrint.
     Elle pousse la toile au lieu de la recouvrir, et suit donc les panneaux
     latéraux déjà en place. -->
<aside class="sidebar plugin-sidebar" id="plugin-sidebar" aria-label="Plug-in" hidden>
  <div class="sidebar-head plugin-head">
    <div class="plugin-head-copy">
      <span class="eyebrow" id="plugin-kicker">PLUGIN</span>
      <h2 id="plugin-title">Effects 2026</h2>
    </div>
    <button class="icon-btn" id="plugin-close" aria-label="Close" data-i18n-aria="common.close">
      <svg viewBox="0 0 24 24"><use href="#i-close"></use></svg>
    </button>
  </div>

  <div class="plugin-scroll">
    <p class="plugin-subtitle" id="plugin-subtitle" data-i18n="plugin.subtitle">
      Glitch and film damage, rendered on your machine. The preview is live on the canvas.
    </p>

    <div class="plugin-effects" id="plugin-effects" role="listbox" aria-label="Effects"></div>

    <div class="plugin-panel">
      <div class="plugin-effect-head">
        <h3 id="plugin-effect-name">—</h3>
        <p id="plugin-effect-desc" class="plugin-effect-desc"></p>
      </div>
      <div class="plugin-params" id="plugin-params"></div>
    </div>

    <div class="plugin-note">
      <BrandMark decorative />
      <span id="plugin-target">—</span>
    </div>
  </div>

  <footer class="plugin-foot">
    <button class="btn ghost sm" id="plugin-reset" data-i18n="common.reset">Reset</button>
    <span class="foot-spacer"></span>
    <button class="btn ghost sm" id="plugin-cancel" data-i18n="common.cancel">Cancel</button>
    <button class="btn primary sm" id="plugin-apply" data-i18n="plugin.applyShort">Apply</button>
  </footer>
</aside>
