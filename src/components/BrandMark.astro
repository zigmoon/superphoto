---
/**
 * Marque officielle SuperPhoto.
 *
 * Le SVG vient de `scripts/brand.mjs`, qui recopie à l'identique le calque
 * visible de `super_photo_blanc.svg` (plaques blanches + anneaux sombres). Il est
 * **inliné** : aucune requête réseau, et le chemin reste valable quand la version
 * web est posée dans un sous-dossier par FTP.
 *
 * L'original ne contient aucun `id` : plusieurs instances peuvent donc coexister
 * dans la page sans se marcher dessus.
 */
import iconSource from '../assets/brand/app-icon.svg?raw';

const viewBox = /viewBox="([^"]*)"/.exec(iconSource)?.[1] ?? '0 0 500 500';
const inner = iconSource
  .replace(/<title>[^<]*<\/title>/, '')
  .replace(/^[\s\S]*?<svg[^>]*>/, '')
  .replace(/<\/svg>\s*$/, '')
  .trim();

interface Props {
  class?: string;
  /** Taille en pixels ; la marque reste carrée. */
  size?: number;
  decorative?: boolean;
}

const { class: className = '', size, decorative = false } = Astro.props;
const style = size ? `width:${size}px;height:${size}px` : undefined;
---

<svg
  class={className}
  viewBox={viewBox}
  style={style}
  role={decorative ? 'presentation' : 'img'}
  aria-hidden={decorative ? 'true' : undefined}
  aria-label={decorative ? undefined : 'SuperPhoto'}
  set:html={inner}
/>
