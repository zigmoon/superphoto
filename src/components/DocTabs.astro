<div class="doc-tabs-bar">
  <div
    class="doc-tabs"
    id="doc-tabs"
    role="tablist"
    aria-label="Open documents"
    data-i18n-aria="tabs.label"
  >
    <span class="doc-tabs-empty" data-i18n="tabs.none">No document</span>
  </div>
  <button
    class="doc-tab-add"
    id="doc-tab-add"
    title="New document"
    aria-label="New document"
    data-i18n-title="tabs.new"
    data-i18n-aria="tabs.new"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-plus"></use></svg>
  </button>
</div>
