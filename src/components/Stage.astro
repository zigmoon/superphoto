---
import BrandMark from './BrandMark.astro';
---
<section class="stage" aria-label="Zone de travail">
  <div class="stage-ribbon">
    <span class="ribbon-label">TOILE</span>
    <span class="ribbon-hint" id="tool-hint">Cliquez pour choisir un calque, glissez pour déplacer son contenu.</span>
  </div>

  <div class="viewport" id="viewport">
    <div class="canvas-pad" id="canvas-pad">
      <div class="canvas-stack" id="canvas-stack" style="display: none;">
        <canvas id="display-canvas" width="1" height="1"></canvas>
        <svg id="overlay" class="overlay" xmlns="http://www.w3.org/2000/svg" width="1" height="1" viewBox="0 0 1 1"></svg>
      </div>
    </div>

    <div class="empty-state" id="empty-state">
      <div class="empty-mark">
        <BrandMark decorative />
      </div>
      <span class="empty-kicker">SUPERPHOTO · PHOTO STUDIO</span>
      <h1>La retouche photo, sans compromis.</h1>
      <p>
        Ouvrez une image ou créez une toile pour commencer. Calques, sélections,
        courbes, niveaux et tracés Bézier vous attendent dans un espace sombre,
        précis et rapide.
      </p>
      <div class="empty-actions">
        <button class="btn primary lg" id="empty-new">
          <svg viewBox="0 0 24 24"><use href="#i-new"></use></svg>
          Nouveau document
        </button>
        <button class="btn ghost lg" id="empty-open">
          <svg viewBox="0 0 24 24"><use href="#i-open"></use></svg>
          Ouvrir depuis l'ordinateur
        </button>
      </div>
      <div class="empty-features">
        <span>Astro</span><i></i><span>Rust / Tauri</span><i></i><span>Windows · macOS · Linux</span>
      </div>
    </div>
  </div>

  <!-- Zoom + plein écran : ancrés en bas à droite de la zone de prévisualisation.
       Placés dans `.stage` (et non en `position: fixed`), ils suivent donc
       instantanément l’ouverture ou la fermeture des panneaux latéraux. -->
  <div class="stage-zoom" id="stage-zoom" aria-label="Zoom et affichage">
    <button class="stage-zoom-btn" id="zoom-out" title="Zoom arrière (Ctrl+-)" aria-label="Zoom arrière">
      <svg viewBox="0 0 24 24"><use href="#i-minus"></use></svg>
    </button>
    <button class="stage-zoom-value" id="zoom-value" title="Zoom 100 % (Ctrl+1)">100 %</button>
    <button class="stage-zoom-btn" id="zoom-in" title="Zoom avant (Ctrl++)" aria-label="Zoom avant">
      <svg viewBox="0 0 24 24"><use href="#i-plus"></use></svg>
    </button>
    <span class="stage-zoom-sep" aria-hidden="true"></span>
    <button class="stage-zoom-btn" id="zoom-fit" title="Ajuster à la fenêtre (Ctrl+0)" aria-label="Ajuster à la fenêtre">
      <svg viewBox="0 0 24 24"><use href="#i-fit"></use></svg>
    </button>
    <button class="stage-zoom-btn" id="btn-fullscreen" title="Plein écran (F11)" aria-label="Passer en plein écran" aria-pressed="false">
      <svg class="fs-icon-enter" viewBox="0 0 24 24"><use href="#i-fullscreen"></use></svg>
      <svg class="fs-icon-exit" viewBox="0 0 24 24"><use href="#i-fullscreen-exit"></use></svg>
    </button>
  </div>
</section>
