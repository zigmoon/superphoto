---
import BrandMark from './BrandMark.astro';
import DocTabs from './DocTabs.astro';
---
<section class="stage" aria-label="Workspace">
  <DocTabs />

  <div class="viewport" id="viewport">
    <div class="canvas-pad" id="canvas-pad">
      <div class="canvas-stack" id="canvas-stack" style="display: none;">
        <canvas id="display-canvas" width="1" height="1"></canvas>
        <svg id="overlay" class="overlay" xmlns="http://www.w3.org/2000/svg" width="1" height="1" viewBox="0 0 1 1"></svg>
      </div>
    </div>

    <div class="empty-state" id="empty-state">
      <div class="empty-mark">
        <BrandMark decorative />
      </div>
      <span class="empty-kicker" data-i18n="stage.emptyKicker">SUPERPHOTO · PHOTO STUDIO</span>
      <h1 data-i18n="stage.emptyTitle">Photo retouching, without compromise.</h1>
      <p data-i18n="stage.emptyBody">
        Open an image or create a canvas to start. Layers, selections, curves,
        levels and Bézier paths await you in a fast, precise workspace.
      </p>
      <div class="empty-actions">
        <button class="btn primary lg" id="empty-new">
          <svg viewBox="0 0 24 24"><use href="#i-new"></use></svg>
          <span data-i18n="new.title">New document</span>
        </button>
        <button class="btn ghost lg" id="empty-open">
          <svg viewBox="0 0 24 24"><use href="#i-open"></use></svg>
          <span data-i18n="new.openComputer">Open from computer</span>
        </button>
      </div>
      <div class="empty-features">
        <span>Astro</span><i></i><span>Rust / Tauri</span><i></i><span data-i18n="stage.emptyFeatures">Windows · macOS · Linux</span>
      </div>
    </div>
  </div>

  <!-- Zoom + plein écran : ancrés en bas à droite de la prévisualisation.
       Placés dans `.stage` (et non en `position: fixed`), ils suivent donc
       instantanément l’ouverture ou la fermeture des panneaux latéraux. -->
  <div class="stage-zoom" id="stage-zoom" aria-label="Zoom and display">
    <button class="stage-zoom-btn" id="zoom-out" title="Zoom out (Ctrl+-)" aria-label="Zoom out (Ctrl+-)" data-i18n-title="stage.zoomOut" data-i18n-aria="stage.zoomOut">
      <svg viewBox="0 0 24 24"><use href="#i-minus"></use></svg>
    </button>
    <button class="stage-zoom-value" id="zoom-value" title="Zoom 100 % (Ctrl+1)" data-i18n-title="stage.zoomValue">100 %</button>
    <button class="stage-zoom-btn" id="zoom-in" title="Zoom in (Ctrl++)" aria-label="Zoom in (Ctrl++)" data-i18n-title="stage.zoomIn" data-i18n-aria="stage.zoomIn">
      <svg viewBox="0 0 24 24"><use href="#i-plus"></use></svg>
    </button>
    <span class="stage-zoom-sep" aria-hidden="true"></span>
    <button class="stage-zoom-btn" id="zoom-fit" title="Fit to window (Ctrl+0)" aria-label="Fit to window (Ctrl+0)" data-i18n-title="stage.zoomFit" data-i18n-aria="stage.zoomFit">
      <svg viewBox="0 0 24 24"><use href="#i-fit"></use></svg>
    </button>
    <button class="stage-zoom-btn" id="btn-fullscreen" title="Full screen (F11)" aria-label="Full screen (F11)" aria-pressed="false" data-i18n-title="stage.fullscreen" data-i18n-aria="stage.fullscreen">
      <svg class="fs-icon-enter" viewBox="0 0 24 24"><use href="#i-fullscreen"></use></svg>
      <svg class="fs-icon-exit" viewBox="0 0 24 24"><use href="#i-fullscreen-exit"></use></svg>
    </button>
  </div>
</section>

<div class="drop-overlay" id="drop-overlay" hidden aria-hidden="true">
  <div class="drop-card">
    <span class="drop-mark"><BrandMark decorative /></span>
    <strong data-i18n="drop.title">Drop to open</strong>
    <small data-i18n="drop.hint">
      PNG, JPEG, WebP, AVIF, GIF, TIFF, BMP, SVG, .sps — several files at once
      open in separate tabs.
    </small>
    <em data-i18n="drop.videoHint">Video files open on their first frame.</em>
  </div>
</div>
