---
import '../styles/app.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'SuperPhoto — Photo retouching studio',
  description = 'SuperPhoto, the photo retouching studio: light or dark theme, layers, curves, levels, live preview and fast export. Astro + Rust, Windows, macOS and Linux.',
} = Astro.props;

// `BASE_URL` vaut « / » pour le bureau (Tauri) et « ./ » pour la version web
// posée par FTP dans un sous-dossier quelconque : toutes les ressources de la
// marque suivent le même chemin, y compris le manifeste.
const asset = (path: string) => `${import.meta.env.BASE_URL}${path}`;

// Les réseaux sociaux et les moteurs exigent des URL absolues. Elles pointent
// sur l'adresse publique réelle (sous-dossier FTP compris) et restent
// surchargeables au build : `PUBLIC_SITE_URL=… npm run build:web`.
const publicBase = import.meta.env.PUBLIC_SITE_URL || 'https://app.zigmoon.com/superphoto/';
const pageUrl = new URL(publicBase).href;
const ogImage = new URL('brand/og-image.png', pageUrl).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'SuperPhoto',
  applicationCategory: 'MultimediaApplication',
  applicationSubCategory: 'Photo editor',
  operatingSystem: 'Web, Windows, macOS, Linux',
  url: pageUrl,
  image: ogImage,
  description,
  inLanguage: ['en', 'fr', 'ja'],
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  featureList: [
    'Layers, masks and blend modes',
    'Non-destructive adjustments: curves, levels, tone, colour',
    'Selections with progressive feathering',
    'PSD import and PSD, TIFF, EPS export',
    'RGB, CMYK and grayscale colour modes',
    'Effects 2026 plug-in pack',
  ],
};
---
<!doctype html>
<html
  lang="en"
  class="theme-light"
  data-theme="light"
  data-theme-mode="light"
  data-accent="ink"
  data-checker="auto"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f8f8" />
    <link rel="canonical" href={pageUrl} />
    <link rel="alternate" hreflang="en" href={pageUrl} />
    <link rel="alternate" hreflang="fr" href={pageUrl} />
    <link rel="alternate" hreflang="ja" href={pageUrl} />
    <link rel="alternate" hreflang="x-default" href={pageUrl} />

    <!-- Marque officielle : SVG adaptatif + repli PNG + icône iOS + manifeste -->
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    <link rel="icon" type="image/png" sizes="32x32" href={asset('favicon-32.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={asset('apple-touch-icon.png')} />
    <link rel="manifest" href={asset('site.webmanifest')} />
    <meta name="application-name" content="SuperPhoto" />
    <meta name="apple-mobile-web-app-title" content="SuperPhoto" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />

    <!-- Partage : carte 1200 × 630 avec la marque -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SuperPhoto" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Logo SuperPhoto sur fond sombre" />
    <meta property="og:url" content={pageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="alternate" type="text/plain" title="LLMs.txt" href={`${import.meta.env.BASE_URL}llms.txt`} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <title>{title}</title>
    <script is:inline>
      // Applique le thème avant le premier rendu : aucun flash clair → sombre.
      (() => {
        const root = document.documentElement;
        const fallback = { theme: 'light', accent: 'ink', checker: 'auto', motion: 'full' };
        let prefs = fallback;
        try {
          const raw = localStorage.getItem('superphoto:prefs:v1');
          if (raw) prefs = Object.assign({}, fallback, JSON.parse(raw));
        } catch (_) {}
        // Interface noir et blanc : les anciennes préférences colorées
        // retombent sur l'encre.
        prefs.accent = 'ink';
        const systemDark =
          typeof matchMedia === 'function' && matchMedia('(prefers-color-scheme: dark)').matches;
        const dark = prefs.theme === 'dark' || (prefs.theme === 'system' && systemDark);
        root.classList.toggle('theme-dark', dark);
        root.classList.toggle('theme-light', !dark);
        root.classList.toggle('reduce-motion', prefs.motion === 'reduced');
        root.dataset.theme = dark ? 'dark' : 'light';
        root.dataset.themeMode = prefs.theme;
        root.dataset.accent = prefs.accent;
        root.dataset.checker = prefs.checker;
        root.style.colorScheme = dark ? 'dark' : 'light';
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', dark ? '#121214' : '#f8f8f8');

        // Langue : choix mémorisé, sinon langue du navigateur (anglais par
        // défaut). Les libellés sont réécrits au chargement du module i18n.
        try {
          const stored = localStorage.getItem('superphoto:lang');
          const supported = ['en', 'fr', 'ja'];
          const detected = (navigator.languages || [navigator.language || 'en'])
            .map((code) => String(code).slice(0, 2).toLowerCase())
            .find((code) => supported.includes(code)) || 'en';
          const lang = supported.includes(stored) ? stored : detected;
          root.lang = lang;
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
